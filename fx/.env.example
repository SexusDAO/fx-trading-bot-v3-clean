# fx/.env.example — 启动 fx 工作流所需的全部环境变量
# 使用方法：
#   cp fx/.env.example fx/.env
#   编辑 fx/.env，填入真实值
#   source fx/.env  （或由 daemon_start.py 启动前在 shell 里 export）
#
# ⚠️  .env 文件已加入 .gitignore，不会进仓库
# ⚠️  带 [必填] 的项缺失时程序会直接报错退出

# ── Binance API [必填] ─────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── 代理 [必填，无代理时填空字符串] ───────────────────────────────────────────
# 格式：socks5://username:password@host:port
BINANCE_PROXY=socks5://user:pass@host:6688
PROXY_URL=socks5://user:pass@host:6688        # 与 BINANCE_PROXY 保持一致

# ── LLM（妖币识别 + 新闻语义判断）[必填] ────────────────────────────────────
OPENAI_API_KEY=your_llm_api_key_here
OPENAI_BASE_URL=https://novaapi.ai            # NovaAPI 兼容 OpenAI 格式
OPENAI_MODEL=claude-opus-4-8-medium           # 默认模型，可按需切换

# ── OpenClaw Jarvis 推送（通知用）[可选] ─────────────────────────────────────
# 如使用 Jarvis notifier，填 gateway port；不填则推送静默失败不影响交易
OPENCLAW_GATEWAY_PORT=8080

# ── Telegram 推送（已弃用，改用 Jarvis；保留兼容）[可选] ─────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 第三方数据源（有内置默认值，可不填）[可选] ───────────────────────────────
# Clawby API（清算图数据代理）
CLAWBY_API_KEY=pk_xBgG9wi3q1ZnIe6peyFrBHQP_6v2hG2C

# CoinGlass API（热力图/清算带）
CG_API_KEY=cg_998dad4b22ea88573763952d7b9e0944de6addfe7e5ec216

# Bykaranteli API（附加数据源）
BYKARANTELI_API_KEY=bk_OXn6K6nkekUKOw1VFwoVdjV3JRQQTh_47eos_3IkNaM
